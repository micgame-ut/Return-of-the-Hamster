    "m_SourceType": 1,
    "m_FunctionName": "StarField",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Background stars and distant galaxies in three layers: many faint, some medium, few bright.\n// Each one blinks in and out on its own cycle (Star Blink Speed), reappearing somewhere new.\n// The sky is mapped onto a cube around the camera and each face is split into a flat grid.\n// Every object stays inside its cell with a margin wider than itself, so it is never cut off.\nStars = 0.0;\nfloat3 a = abs(Dir);\nfloat2 uv;\nfloat face;\nif (a.x >= a.y && a.x >= a.z) { uv = Dir.yz / a.x; face = Dir.x > 0.0 ? 0.0 : 1.0; }\nelse if (a.y >= a.z)          { uv = Dir.xz / a.y; face = Dir.y > 0.0 ? 2.0 : 3.0; }\nelse                          { uv = Dir.xy / a.z; face = Dir.z > 0.0 ? 4.0 : 5.0; }\n[unroll]\nfor (int layer = 0; layer < 3; layer++)\n{\n    // 0.785 keeps cell size close to the old 3D cells (one cube face spans about 90 degrees).\n    float scale = Density * 0.785 * (layer == 0 ? 1.0 : (layer == 1 ? 0.35 : 0.12));\n    float2 g = uv * scale;\n    float2 cell = floor(g);\n    // Each cell has its own life cycle: fade in, shine, fade out, then re-roll for the next cycle.\n    // A fixed per-cell offset keeps cells from blinking together.\n    float3 h0 = frac(float3(cell, face + layer * 7.0) * float3(0.1031, 0.1030, 0.0973));\n    h0 += dot(h0, h0.yxz + 33.33);\n    float lifeT = Time * BlinkSpeed + frac((h0.x + h0.y) * h0.z);\n    float cycle = floor(lifeT);\n    float life = (BlinkSpeed > 0.0) ? smoothstep(0.0, 0.2, frac(lifeT)) * smoothstep(1.0, 0.8, frac(lifeT)) : 1.0;\n    // The cycle number is part of the roll, so position, color, brightness and whether the cell\n    // has a star all change each cycle.\n    float3 h = frac(float3(cell + cycle * float2(13.7, 7.3), face + layer * 7.0) * float3(0.1031, 0.1030, 0.0973));\n    h += dot(h, h.yxz + 33.33);\n    float3 r = frac((h.xxy + h.yxx) * h.zyx);\n    float pick = frac(r.x * 17.13 + r.y * 3.71);\n    float amount = Amount * (layer == 0 ? 1.0 : (layer == 1 ? 0.5 : 0.3));\n    if (pick >= amount) continue;\n    float size = Size * (layer == 0 ? 1.0 : 1.1);\n    bool galaxy = (layer == 0 && frac(r.z * 23.7 + r.x * 5.3) < Galaxies);\n    float spikeLen = 0.15;\n    float reach = galaxy ? size * 2.0 : (layer == 2 ? max(size, spikeLen) : size);\n    float margin = min(reach, 0.45);\n    float2 l = g - (cell + margin + (1.0 - 2.0 * margin) * r.xy);\n    float3 col;\n    float shape;\n    if (galaxy)\n    {\n        // Galaxy: soft ellipse at a random angle, warm beige.\n        float ang = r.x * 3.1416;\n        float2 rl = float2(l.x * cos(ang) - l.y * sin(ang), l.x * sin(ang) + l.y * cos(ang));\n        float e = length(float2(rl.x, rl.y * (1.5 + 2.5 * r.z)));\n        shape = saturate(1.0 - e / (size * 2.0));\n        shape *= shape;\n        col = lerp(float3(1.0, 0.85, 0.65), float3(1.0, 0.65, 0.4), r.y) * 0.6;\n    }\n    else\n    {\n        shape = saturate(1.0 - length(l) / max(size, 0.0001));\n        shape *= shape;\n        if (layer == 2)\n        {\n            // 4-point spikes, kept inside the cell.\n            float w = 0.012;\n            float spike = exp(-abs(l.y) / w) * saturate(1.0 - abs(l.x) / spikeLen)\n                        + exp(-abs(l.x) / w) * saturate(1.0 - abs(l.y) / spikeLen);\n            shape += Spikes * spike * 0.5;\n        }\n        // Mostly warm, few blue; most stars dim, few bright.\n        float3 tint = lerp(float3(0.65, 0.78, 1.0), float3(1.0, 0.8, 0.55), sqrt(r.z));\n        col = lerp(float3(1.0, 1.0, 1.0), tint, ColorVar);\n        float twinkle = 1.0 - Twinkle * (0.5 + 0.5 * sin(Time * (1.0 + 3.0 * r.y) + r.z * 6.2832));\n        float layerBright = layer == 0 ? 0.35 : (layer == 1 ? 1.0 : 2.0);\n        col *= twinkle * layerBright * (0.3 + 0.7 * r.y * r.y);\n    }\n    Stars += col * shape * Brightness * life;\n}"
}

