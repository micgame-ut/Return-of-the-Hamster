    "m_SourceType": 1,
    "m_FunctionName": "NebulaVolumeNoise",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Nothing to draw where the center fade has removed the clouds: skip all the noise.\nif (Fade <= 0.0) { Density = 0.0; Coverage = 0.0; Depth = 1.0; Dust = 0.0; Tint = 0.0; return; }\n// Volumetric raymarch through a 3D cloud field the camera flies through along +Z of Dir.\n// Stage 0 = dust and stage 1 = tint, read once at the middle of the ray.\n// Stages 2+ are ray steps: each reads a one-octave warp, then the warped density,\n// and absorbs light like fog. Stops early once the ray is nearly opaque.\n// Cell indices wrap every 64 cells (the baked texture's size) so large offsets (endless mode) stay precise.\nfloat3 flight = float3(0.0, 0.0, Offset);\nfloat3 midP = (Dir * (0.5 * (Near + Far)) + flight) * Scale;\nfloat steps = clamp(floor(Steps), 4.0, 48.0);\nfloat stepLen = (Far - Near) / steps;\n// Per-pixel offset along the ray hides banding between steps.\nfloat jitter = frac(sin(dot(Dir, float3(12.9898, 78.233, 37.719))) * 43758.5453);\nfloat transmittance = 1.0;\nfloat densitySum = 0.0;\nfloat depthSum = 0.0;\nfloat weightSum = 0.0;\nDust = 0.0;\nTint = 0.0;\n[loop]\nfor (int stage = 0; stage < 50; stage++)\n{\n    float t = 0.0;\n    float3 basePos = midP;\n    if (stage >= 2)\n    {\n        float i = stage - 2;\n        if (i >= steps || transmittance < 0.03) break;\n        t = (i + jitter) / steps;\n        basePos = (Dir * lerp(Near, Far, t) + flight) * Scale;\n    }\n    float3 warp = 0.0;\n    float n = 0.0;\n    [loop]\n    for (int sub = 0; sub < 2; sub++)\n    {\n        float3 q;\n        float octaves;\n        if (stage == 0) { if (sub == 1) break; q = midP * DustScale + float3(-12.3, 45.1, 0.0); octaves = min(Octaves, 2.0); }\n        else if (stage == 1) { if (sub == 1) break; q = midP * TintScale + float3(5.2, -8.3, 0.0); octaves = 1.0; }\n        else if (sub == 0) { q = basePos + float3(31.4, 17.7, 0.0); octaves = 1.0; }\n        else { q = basePos + warp * Warp; octaves = Octaves; }\n        float sum = 0.0;\n        float amp = 1.0;\n        float total = 0.0;\n        [loop]\n        for (int o = 0; o < 6; o++)\n        {\n            if (o >= octaves) break;\n            q -= floor(q / 64.0) * 64.0;\n            float3 cell = floor(q);\n            float3 f = q - cell;\n            float3 u = f * f * (3.0 - 2.0 * f);\n            // Texel centers sit at +0.5; reading at cell + u blends the 8 corners with the same smooth fade.\n            float v = SAMPLE_TEXTURE3D_LOD(NoiseTex.tex, NoiseTex.samplerstate, (cell + u + 0.5) / 64.0, 0).r;\n            sum += v * amp;\n            total += amp;\n            amp *= Detail;\n            q = q * 2.03 + float3(7.13, 3.71, 1.37);\n        }\n        float nn = sum / max(total, 0.0001);\n        if (stage >= 2 && sub == 0) warp = float3(cos(nn * 6.2832), sin(nn * 6.2832), 0.0);\n        else n = nn;\n    }\n    if (stage == 0) Dust = n;\n    else if (stage == 1) Tint = n;\n    else\n    {\n        float d = smoothstep(Threshold, Threshold + Softness, n);\n        float a = 1.0 - exp(-d * Absorption * stepLen);\n        float w = a * transmittance;\n        densitySum += w * n;\n        depthSum += w * t;\n        weightSum += w;\n        transmittance *= 1.0 - a;\n    }\n}\nCoverage = 1.0 - transmittance;\nDensity = (weightSum > 0.0001) ? densitySum / weightSum : 0.0;\nDepth = (weightSum > 0.0001) ? depthSum / weightSum : 1.0;"
}

