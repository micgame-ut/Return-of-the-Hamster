  "m_SourceType": 1,
  "m_FunctionName": "HeatwaveNoise",
  "m_FunctionSource": "",
  "m_FunctionSourceUsePragmas": true,
  "m_FunctionBody": "// Depth slices through a 3D cloud field the camera flies through along +Z of Dir.\n// Stages 0-2 (warp, dust, tint) are read once at the middle slice; stages 3+ are the slices,\n// combined near over far like layers of fog.\n// Cell indices wrap every 289 cells so large offsets (endless mode) stay precise.\nfloat3 flight = float3(0.0, 0.0, Offset);\nfloat3 midP = (Dir * (0.5 * (Near + Far)) + flight) * Scale;\nfloat sliceCount = clamp(floor(Slices), 1.0, 4.0);\nfloat3 warp = 0.0;\nfloat densitySum = 0.0;\nfloat depthSum = 0.0;\nfloat alpha = 0.0;\nDust = 0.0;\nTint = 0.0;\nfor (int stage = 0; stage < 7; stage++)\n{\n    float slice = stage - 3;\n    if (slice >= sliceCount) break;\n    float t = (sliceCount > 1.0) ? slice / (sliceCount - 1.0) : 0.0;\n    float3 q;\n    float octaves = Octaves;\n    if (stage == 0) { q = midP + float3(31.4, 17.7, 0.0); octaves = min(Octaves, 2.0); }\n    else if (stage == 1) { q = midP * DustScale + float3(-12.3, 45.1, 0.0); octaves = max(1.0, Octaves - 1.0); }\n    else if (stage == 2) { q = midP * TintScale + float3(5.2, -8.3, 0.0); octaves = 1.0; }\n    else { q = (Dir * lerp(Near, Far, t) + flight) * Scale + warp * Warp; }\n    float sum = 0.0;\n    float amp = 1.0;\n    float total = 0.0;\n    for (int o = 0; o < 6; o++)\n    {\n        if (o >= octaves) break;\n        q -= floor(q / 289.0) * 289.0;\n        float3 cell = floor(q);\n        float3 f = q - cell;\n        float3 u = f * f * (3.0 - 2.0 * f);\n        float corner[8];\n        for (int k = 0; k < 8; k++)\n        {\n            float3 id = cell + float3(k & 1, (k >> 1) & 1, (k >> 2) & 1);\n            id -= floor(id / 289.0) * 289.0;\n            float3 h = frac(id * 0.1031);\n            h += dot(h, h.zyx + 31.32);\n            corner[k] = frac((h.x + h.y) * h.z);\n        }\n        float v = lerp(lerp(lerp(corner[0], corner[1], u.x), lerp(corner[2], corner[3], u.x), u.y),\n                       lerp(lerp(corner[4], corner[5], u.x), lerp(corner[6], corner[7], u.x), u.y), u.z);\n        sum += v * amp;\n        total += amp;\n        amp *= Detail;\n        q = q * 2.03 + float3(7.13, 3.71, 1.37);\n    }\n    float n = sum / max(total, 0.0001);\n    if (stage == 0) warp = float3(cos(n * 6.2832), sin(n * 6.2832), 0.0);\n    else if (stage == 1) Dust = n;\n    else if (stage == 2) Tint = n;\n    else\n    {\n        float m = smoothstep(Threshold, Threshold + Softness, n);\n        float w = m * (1.0 - alpha);\n        densitySum += w * n;\n        depthSum += w * t;\n        alpha += w;\n    }\n}\nCoverage = alpha;\nDensity = (alpha > 0.0001) ? densitySum / alpha : 0.0;\nDepth = (alpha > 0.0001) ? depthSum / alpha : 1.0;"
}

